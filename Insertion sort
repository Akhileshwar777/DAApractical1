#include <iostream>
#include <vector>

// Function to perform Insertion Sort on a reference vector
void insertionSort(std::vector<int>& arr) {
    int n = arr.size();
    
    // Iterate from the second element to the end of the array
    for (int i = 1; i < n; ++i) {
        int key = arr[i]; // The element to be positioned
        int j = i - 1;

        // Shift elements of arr[0..i-1] that are greater than key
        // to one position ahead of their current position
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        // Insert the key into its correct sorted location
        arr[j + 1] = key;
    }
}

// Utility function to print array elements
void printArray(const std::vector<int>& arr) {
    for (int num : arr) {
        std::cout << num << " ";
    }
    std::cout << std::endl;
}

int main() {
    std::vector<int> data = {12, 11, 13, 5, 6};
    
    std::cout << "Original array: ";
    printArray(data);

    insertionSort(data);

    std::cout << "Sorted array:   ";
    printArray(data);

    return 0;
}
